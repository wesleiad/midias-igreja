{
  "expo": {
    "name": "Mídias - Igreja",
    "slug": "fotos-comvida",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1115",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wesleidomingues.fotoscomvida"
    },
    "android": {
      "package": "com.wesleidomingues.fotoscomvida",
      "adaptiveIcon": {
        "backgroundColor": "#0f1115",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "O Mídias - Igreja precisa ver suas fotos para separar as boas das ruins.",
          "savePhotosPermission": "O Mídias - Igreja salva as fotos melhoradas no álbum Mídias - Igreja.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha o logo da igreja para usar como marca d'água.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ]
    ],
    "owner": "wesleiad34",
    "extra": {
      "eas": {
        "projectId": "b42fd2c1-3d95-45e3-9cc0-1c5af8445d2a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b42fd2c1-3d95-45e3-9cc0-1c5af8445d2a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
