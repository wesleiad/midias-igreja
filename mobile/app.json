{
  "expo": {
    "name": "Fotos Com.Vida",
    "slug": "fotos-comvida",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1115",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wesleidomingues.fotoscomvida"
    },
    "android": {
      "package": "com.wesleidomingues.fotoscomvida",
      "adaptiveIcon": {
        "backgroundColor": "#0f1115",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "O Fotos Com.Vida precisa ver suas fotos para separar as boas das ruins.",
          "savePhotosPermission": "O Fotos Com.Vida salva as fotos melhoradas no álbum Fotos Com.Vida.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha o logo da igreja para usar como marca d'água."
        }
      ]
    ],
    "owner": "wesleiad34"
  }
}
